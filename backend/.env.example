# Banco (docker compose da raiz sobe um Postgres nesta URL)
DATABASE_URL="postgresql://guia:guia@localhost:5433/guia?schema=public"

JWT_SECRET="troque-por-um-texto-longo-e-aleatorio"
PORT=3333
# Separe várias origens por vírgula (ex.: localhost e o domínio da Vercel)
FRONTEND_URL="http://localhost:5173"

# Usuária criada pelo seed (valores de teste)
ADMIN_EMAIL="admin@guia.local"
ADMIN_SENHA="admin123"

# Dados que aparecem nas propostas e e-mails
INFLUENCER_NOME="Guia Gastronômico Joinville"
INFLUENCER_INSTAGRAM="@guiagastronomicojoinville"
INFLUENCER_EMAIL="contato@exemplo.com"

# SMTP opcional. Sem ele, os e-mails vão para uma caixa de teste (Ethereal)
# e o link de visualização aparece no terminal e no histórico de notificações.
# Exemplo com Gmail: host smtp.gmail.com, porta 465, usuário = e-mail, senha = "senha de app".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
